# .env.example
# Template public des variables d'environnement attendues par ce workspace.
# Ce fichier peut être commité : il ne doit jamais contenir de vraies valeurs.
# Pour l'utiliser : copier en .env puis renseigner les vraies clés.

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Notion
NOTION_API_KEY=

# Google
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel
VERCEL_TOKEN=

# GitHub
GITHUB_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
