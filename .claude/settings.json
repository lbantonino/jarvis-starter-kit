{
  "permissions": {
    "allow": [
      "ClaudeInChromeDomain(support.coros.com)",
      "ClaudeInChromeDomain(coros-teams.feishu.cn)",
      "ClaudeInChromeDomain(localhost:60170)",
      "ClaudeInChromeDomain(coory-beta.vercel.app)",
      "ClaudeInChromeDomain(emplois.be.indeed.com)",
      "ClaudeInChromeDomain(jobs.battlekart.com)",
      "ClaudeInChromeDomain(lbantonino.com)"
    ],
    "deny": [
      "Read(./livrables/Site-Web/Portfolio/node_modules/**)",
      "Read(./livrables/Site-Web/Portfolio/.next/**)",
      "Read(./livrables/Site-Web/Portfolio/public/projects/**)",
      "Read(./livrables/Site-Web/Portfolio/public/avatar/**)",
      "Read(./livrables/Site-Web/Portfolio/design/originaux/**)",
      "Read(./livrables/Site-Web/behybrid-website/node_modules/**)",
      "Read(./livrables/Site-Web/behybrid-website/.next/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' | grep -qiE \"git .*commit\" && echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"Rappel BEHYBRID: si ce commit concerne le projet behybrid-website, verifie AVANT de committer que JOURNAL-DES-SESSIONS.md (local, hors GitHub) reflete la session. Le README est la documentation du projet : ne le modifier que si la documentation change.\"}}' || true"
          }
        ]
      }
    ]
  }
}
